@article{ward2005,
  title = {Inferring the Depth Distribution of Catchability for Pelagic Fishes and Correcting for Variations in the Depth of Longline Fishing Gear},
  author = {Ward, Peter and Myers, Ransom A},
  year = 2005,
  month = may,
  journal = {Canadian Journal of Fisheries and Aquatic Sciences},
  volume = {62},
  number = {5},
