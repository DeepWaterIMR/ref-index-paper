@article{baudron2020,
  title = {Changing Fish Distributions Challenge the Effective Management of {{European}} Fisheries},
  author = {Baudron, Alan Ronan and Brunel, Thomas and Blanchet, Marie-Anne and Hidalgo, Manuel and Chust, Guillem and Brown, Elliot John and Kleisner, Kristin M. and Millar, Colin and MacKenzie, Brian R. and Nikolioudakis, Nikolaos and Fernandes, Jose A. and Fernandes, Paul G.},
  year = 2020,
  month = apr,
  journal = {Ecography},
  volume = {43},
  number = {4},
  pages = {494--505},
  issn = {0906-7590, 1600-0587},
  doi = {10.1111/ecog.04864},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/ecog.04864},
  urldate = {2024-12-18},
  abstract = {Changes in fish distribution are being observed across the globe. In Europe's Common Fisheries Policy, the share of the catch of each fish stock is split among management areas using a fixed allocation key known as `Relative Stability': in each management area, member states get the same proportion of the total catch each year. That proportion is largely based on catches made by those member states in the 1970s. Changes in distribution can, therefore, result in a mismatch between quota shares and regional abundances within management areas, with potential repercussions for the status of fish stocks and the fisheries that depend on them. Assessing distribution changes is crucial to ensure adequate management and sustainable exploitation of our fish resources. We analysed scientific survey data using a three-tiered analytical approach to provide, for the first time, an overview of changes in distribution for 19 northeast Atlantic fish species encompassing 73 commercial stocks over 30 yr. All species have experienced changes in distribution, five of which did so across management areas. A cross-species analysis suggested that shifts in areas of suitable thermal habitat, and density-dependent use of these areas, are at least partly responsible for the observed changes. These findings challenge the current use of relative stability to allocate quotas.},
  langid = {english}
}

@article{berger2017,
  title = {Space Oddity: {{The}} Mission for Spatial Integration},
  author = {Berger, Aaron M. and Goethel, Daniel R. and Lynch, Patrick D. and Quinn, Terrance and Mormede, Sophie and McKenzie, Jeremy and Dunn, Alistair},
  year = 2017,
  month = nov,
  journal = {Canadian Journal of Fisheries and Aquatic Sciences},
  volume = {74},
  number = {11},
  pages = {1698--1716},
  doi = {10.1139/cjfas-2017-0150},
  url = {http://www.nrcresearchpress.com/doi/10.1139/cjfas-2017-0150},
  abstract = {Fishery management decisions are commonly guided by stock assessment models that aggregate outputs across the spatial domain of the species. With refined understanding of spatial population structures, scientists have begun to address how spatiotemporal mismatches among the scale of ecological processes, data collection programs, and stock assessment methods (or assumptions) influence the reliability and, ultimately, appropriateness of regional fishery management (e.g., assigning regional quotas). Development and evaluation of spatial modeling techniques to improve fisheries assessment and management have increased rapidly in recent years. We overview the historical context of spatial models in fisheries science, highlight recent advances in spatial modeling, and discuss how spatial models have been incorporated into the management process. Despite limited examples where spatial assessment models are used as the basis for management advice, continued investment in fine-scale data collection and associated spatial analyses will improve integration of spatial dynamics and ecosystem-level interactions in stock assessment. In the near future, spatiotemporal fisheries management advice will increasingly rely on fine-scale outputs from spatial analyses.}
}

